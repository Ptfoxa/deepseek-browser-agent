{
  "name": "deepseek-browser-agent",
  "version": "0.2.0",
  "private": true,
  "description": "A Chrome side-panel browser agent powered by the DeepSeek API, with human-approved, allow-listed page actions.",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "secret-scan": "node scripts/secret-scan.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run secret-scan"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.55.0",
    "playwright-core": "1.55.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.4"
  }
}
